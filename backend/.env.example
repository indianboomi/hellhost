# Set these as private environment variables in your backend host. Never commit real secrets.
PORT=3000
ALLOWED_ORIGIN=https://YOUR-GITHUB-PAGES-DOMAIN
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"hellhostlogin"}
PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_PANEL_URL=https://panel.example.com
PTERODACTYL_APPLICATION_API_KEY=ptla_REPLACE_ME
PTERODACTYL_NODE_ID=1
PTERODACTYL_LOCATION_ID=1
PTERODACTYL_EGG_ID=1
PTERODACTYL_DOCKER_IMAGE=ghcr.io/pterodactyl/yolks:java_21
PTERODACTYL_STARTUP=java -Xms128M -XX:MaxRAMPercentage=95.0 -jar server.jar
# Optional egg environment JSON. Match the variables required by the selected Minecraft egg.
PTERODACTYL_ENVIRONMENT_JSON={"SERVER_JARFILE":"server.jar","MINECRAFT_VERSION":"latest","BUILD_NUMBER":"latest","EULA":"TRUE"}
SERVER_MEMORY_MB=2048
SERVER_DISK_MB=5120
SERVER_CPU_PERCENT=100
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET